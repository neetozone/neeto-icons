{
  "name": "@bigbinary/neeto-icons-rn",
  "version": "1.20.74",
  "main": "./dist/icons/index.ts",
  "types": "./dist/icons/index.ts",
  "author": "sangameshsomawar",
  "license": "MIT",
  "scripts": {
    "generate": "svgr --out-dir dist --native --index-template index-template.js -- ../source"
  },
  "exports": {
    "./typeface-logos": {
      "import": "./dist/typefaceLogos",
      "default": "./dist/typefaceLogos"
    },
    "./app-icons": {
      "import": "./dist/appIcons",
      "default": "./dist/appIcons"
    },
    "./logos": {
      "import": "./dist/logos",
      "default": "./dist/logos"
    },
    "./misc": {
      "import": "./dist/misc",
      "default": "./dist/misc"
    },
    "./elements": {
      "import": "./dist/elements",
      "default": "./dist/elements"
    },
    ".": {
      "import": "./dist/icons",
      "default": "./dist/icons"
    }
  },
  "devDependencies": {
    "@svgr/cli": "^8.1.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-svg": ">=13.0.0"
  },
  "repository": "https://github.com/bigbinary/neeto-icons.git",
  "sideEffects": false
}
