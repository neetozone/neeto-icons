{
  "name": "@bigbinary/neeto-icons-rn",
  "version": "1.21.0",
  "main": "./dist/icons/index.ts",
  "author": "sangameshsomawar",
  "license": "MIT",
  "scripts": {
    "generate": "svgr --out-dir dist --native --index-template index-template.js -- ../source"
  },
  "exports": {
    "./typeface-logos": {
      "import": "./dist/typefaceLogos/index.ts",
      "default": "./dist/typefaceLogos/index.ts"
    },
    "./app-icons": {
      "import": "./dist/appIcons/index.ts",
      "default": "./dist/appIcons/index.ts"
    },
    "./logos": {
      "import": "./dist/logos/index.ts",
      "default": "./dist/logos/index.ts"
    },
    "./misc": {
      "import": "./dist/misc/index.ts",
      "default": "./dist/misc/index.ts"
    },
    "./elements": {
      "import": "./dist/elements/index.ts",
      "default": "./dist/elements/index.ts"
    },
    "./types": {
      "import": "./types.ts",
      "default": "./types.ts"
    },
    ".": {
      "import": "./dist/icons/index.ts",
      "default": "./dist/icons/index.ts"
    }
  },
  "devDependencies": {
    "@svgr/cli": "^8.1.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-native": ">=0.78.0",
    "react-native-svg": ">=13.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-svg": ">=13.0.0"
  },
  "repository": "https://github.com/bigbinary/neeto-icons.git",
  "sideEffects": false
}
